    <rect x="180" y="180" width="250" height="180" rx="18" fill="#0C1A2A" stroke="#4FE6C4" stroke-width="2"/>
    <rect x="575" y="180" width="250" height="180" rx="18" fill="#0C1A2A" stroke="#67A1FF" stroke-width="2"/>
