    <path d="M1040 360V410" stroke="url(#line)" stroke-width="7" stroke-linecap="round"/>

    <circle cx="360" cy="270" r="36" fill="#30D7AD"/>
    <circle cx="700" cy="270" r="36" fill="#5AA9FF"/>
    <circle cx="1040" cy="270" r="36" fill="#76F5D8"/>

