    <path d="M430 270H575" stroke="url(#line)" stroke-width="7" stroke-linecap="round"/>
    <path d="M825 270H970" stroke="url(#line)" stroke-width="7" stroke-linecap="round"/>
    <path d="M360 360V410" stroke="url(#line)" stroke-width="7" stroke-linecap="round"/>
